  "info": {
    "_postman_id": "54c3dec8-7b02-4771-8ddf-ab7a4e3c9117",
    "name": "Config Server API",
    "description": "Routes through {{HOST}}/config. The host must be allowed by GATEWAY_ALLOWED_CONFIGSERVER_HOSTS. GET requests require configserver:read or global:fullAccess. Encryption routes require a valid token and depend on the server encryption configuration. Use test inputs and keep credentials out of shared variables.",
