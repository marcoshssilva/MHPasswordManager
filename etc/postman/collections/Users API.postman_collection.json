        {
          "name": "Find account by email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{HOST}}/mypass-manager/users/account/byEmail?email=demo@example.com",
              "host": [
                "{{HOST}}"
              ],
              "path": [
                "mypass-manager",
                "users",
                "account",
                "byEmail"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "demo@example.com"
                }
              ]
            },
            "description": "Access rule: `hasAnyAuthority('SCOPE_global:fullAccess', 'SCOPE_users:searchByEmail') || hasAnyRole('ADMIN', 'MASTER')`."
          },
          "response": []
        },
