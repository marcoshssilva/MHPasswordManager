  "item": [
    {
      "name": "Registration & account recovery",
      "item": [
        {
          "name": "Register account",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"User\",\n  \"email\": \"demo@example.com\",\n  \"username\": \"demo\",\n  \"password\": \"{{examplePassword}}\",\n  \"confirmationPassword\": \"{{examplePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{HOST}}/mypass-manager/auth/api/account/register",
              "host": [
                "{{HOST}}"
              ],
              "path": [
                "mypass-manager",
                "auth",
                "api",
                "account",
                "register"
              ]
            },
            "description": "Use the XSRF-TOKEN cookie from the authentication site and its matching X-XSRF-TOKEN header. Keep the same browser/client context across recovery steps."
          },
          "response": []
        },
        {
          "name": "Verify registration link",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{HOST}}/mypass-manager/auth/verify/{{code}}",
              "host": [
                "{{HOST}}"
              ],
              "path": [
                "mypass-manager",
                "auth",
                "verify",
                "{{code}}"
              ]
            },
            "description": "Account verification link from email. Returns HTML."
          },
          "response": []
        },
        {
          "name": "Request password reset code",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identification\": \"demo@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{HOST}}/mypass-manager/auth/api/account/forgot/step1",
              "host": [
                "{{HOST}}"
              ],
              "path": [
                "mypass-manager",
                "auth",
                "api",
                "account",
                "forgot",
                "step1"
              ]
            },
            "description": "Use the XSRF-TOKEN cookie from the authentication site and its matching X-XSRF-TOKEN header. Keep the same browser/client context across recovery steps."
          },
          "response": []
        },
        {
          "name": "Reset password with recovery code",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{code}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{HOST}}/mypass-manager/auth/api/account/forgot/step2",
              "host": [
                "{{HOST}}"
              ],
              "path": [
                "mypass-manager",
                "auth",
                "api",
                "account",
                "forgot",
                "step2"
              ]
            },
            "description": "Use the XSRF-TOKEN cookie from the authentication site and its matching X-XSRF-TOKEN header. Keep the same browser/client context across recovery steps."
          },
          "response": []
        }
      ]
    },
    {
      "name": "OAuth2 & OpenID endpoints",
      "item": [
        {
          "name": "Authorize client",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{HOST}}/mypass-manager/auth/oauth2/authorize?response_type=code&client_id={{CLIENT_ID}}&redirect_uri={{redirectUri}}&scope=openid&state={{oauthState}}",
              "host": [
                "{{HOST}}"
              ],
              "path": [
                "mypass-manager",
                "auth",
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{CLIENT_ID}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirectUri}}"
                },
                {
                  "key": "scope",
                  "value": "openid"
                },
                {
                  "key": "state",
                  "value": "{{oauthState}}"
                },
                {
                  "key": "code_challenge",
                  "value": "{{codeChallenge}}",
                  "disabled": true
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256",
                  "disabled": true
                }
              ]
            },
            "description": "Browser session and registered redirect URI required. For regular use, obtain the OAuth2 token from the collection Authorization tab."
          },
          "response": []
        },
        {
          "name": "Exchange authorization code",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{CLIENT_ID}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{CLIENT_SECRET}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "type": "text",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "type": "text",
                  "value": "{{authorizationCode}}"
                },
                {
                  "key": "redirect_uri",
                  "type": "text",
                  "value": "{{redirectUri}}"
                },
                {
                  "key": "code_verifier",
                  "type": "text",
                  "value": "{{codeVerifier}}",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{HOST}}/mypass-manager/auth/oauth2/token",
              "host": [
                "{{HOST}}"
              ],
              "path": [
                "mypass-manager",
                "auth",
                "oauth2",
                "token"
              ]
            }
          },
          "response": []
