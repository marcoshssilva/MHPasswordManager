    {
      "name": "Register instance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instance\": {\n    \"instanceId\": \"{{eurekaInstanceId}}\",\n    \"hostName\": \"example-service\",\n    \"app\": \"{{eurekaApp}}\",\n    \"ipAddr\": \"127.0.0.1\",\n    \"status\": \"UP\",\n    \"port\": {\n      \"$\": 8080,\n      \"@enabled\": \"true\"\n    },\n    \"securePort\": {\n      \"$\": 443,\n      \"@enabled\": \"false\"\n    },\n    \"vipAddress\": \"{{eurekaVip}}\",\n    \"secureVipAddress\": \"{{eurekaSecureVip}}\",\n    \"dataCenterInfo\": {\n      \"@class\": \"com.netflix.appinfo.InstanceInfo$DefaultDataCenterInfo\",\n      \"name\": \"MyOwn\"\n    },\n    \"metadata\": {\n      \"source\": \"postman\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{HOST}}/eureka/apps/{{eurekaApp}}",
          "host": [
            "{{HOST}}"
          ],
          "path": [
            "eureka",
            "apps",
            "{{eurekaApp}}"
          ]
        },
        "description": "Requires eureka:write or global:fullAccess. Use a test instance."
      },
      "response": []
